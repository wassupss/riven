<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Merged into the bundled app's Info.plist by tauri build. App Transport
     Security blocks plain http:// in a bundled app; the browser panel opens any
     site the user types, as Electron's did. tauri/run.sh writes the same key
     into the dev .app. -->
<dict>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <true/>
  </dict>
</dict>
</plist>
